{
  "name": "ghost-tamer-forum",
  "version": "1.0.0",
  "private": true,
  "description": "驭鬼者论坛 —— 基于《神秘复苏》设定的灵异论坛全栈应用(NestJS + React + PostgreSQL)",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nest start --watch",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:server": "nest build",
    "build:client": "vite build",
    "start": "node dist/server/main.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/database/seed.ts",
    "type:check": "concurrently -n server,client -c blue,green \"npm run type:check:server\" \"npm run type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "lint": "eslint . --quiet"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
