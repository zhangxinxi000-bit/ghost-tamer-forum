    "@nestjs/schematics": "^10.2.3",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^5.0.3",
    "@types/hbs": "^4.0.5",
