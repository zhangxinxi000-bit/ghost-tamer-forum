{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "server",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.node.json",
    "builder": {
      "type": "swc",
      "options": {
        "filenames": ["server", "shared"],
        "stripLeadingPaths": false
      }
    }
  }
}
